	<!--
		Unlocks the ability to destroy a locked door via multiple kicks.
		Does not require un-equipping the primary weapon in order to use.
		Replaces the normal Kick action when in inventory.
	-->
	<FeetOfSteel name="FeetOfSteel" inventoryBinding="SupportGear3">
		<!--
			The total time it takes to destroy a door is taken from the door's "breachTimeMsec" param (the same one used for crowbars)
			   It is then multiplied by the efficiency percent.
			   Then it's slightly adjusted in order to make the door break on precisely the last kick event.
			Note that efficiency is modified by fieldSkills innate ability, which currently starts at -25% (a -25,+25 range is a bit too much?)
			The number of kicks = breachTimeMsec / timePerKickMsec

			'damagePerKick' is not used for doors! But it will be used when kicking any other entity type (if we bind this equipment to other entity types)
			  For those, the total destroy time = (entityHealth / damagePerKick) * timePerKick
		      'damageType' is here just for fun.
		-->
		<ModifiableParams
			efficiencyPercent="80"
			audibleSoundRadius="12.0"
			timePerKickMsec="1000"
			damagePerKick="20"
			damageType="1"
		/>
		<MobilityModifiers moveSpeedModifierPercent="0" turnSpeedModifierPercent="0"/>
	</FeetOfSteel>

