<Equipment>

	<!-- M9 Pistol -->

	<Bind eqp="M9 Pistol NWS">
		<to name="SwatLeader"/>
		<to name="SwatAssaulter"/>
		<to name="SwatSapper"/>


		<!-- ammo, the first one is the default
			Note: instead of binding ammo to pistols (which would be the logical way), we do it the other way, to be able to keep track of the defaults and have a 1-to-many equivalence which is easier to use in code
		-->
		<to name="919FMJM882_NWSHandgun"/>
		<to name="919JHPM1153_NWSHandgun"/>

		<!-- scopes, the first one is the default -->
		<to name="IronSights_Pistol"/>
	</Bind>
	<Firearm name="M9 Pistol NWS" inventoryBinding="SecondaryWeapon" category="pistol" unlockCost="0"
			tooltip="@firearm_m9_name"
			description="@firearm_m9_desc"
			img="data/models/weapons/m9_ui.dds"

			animationSet="pistol"
		>
		<MobilityModifiers moveSpeedModifierPercent="-2" turnSpeedModifierPercent="0"/>
		<RenderObject3D model="data/models/weapons/m9.khm" attachSlot="prop_sidearm" diffuseTex="data/models/weapons/m9.dds" skipGOSSAO="true"/>

		<ModifiableParams
			numPellets="1"
			roundsPerMagazine="15"
			closedBolt="1"

			cyclicReload="0"
			reloadTime="1400"
			reloadEmptyTime="1800"
			changeInTime="1000"
			changeOutTime="1000"
			readyTime="100"
			guardTime="50"

			accuracyStart="85"
			accuracyEnd="60"
			accuracyStartDist="0"
			accuracyEndDist="40"
		/>

		<Params
			caliberInfoText="@firearm_caliber_9x19_name"
			operationInfoText="@firearm_operation_semiauto_name"
			ejectingShellEntity="BulletCasingSmall"
			magazineEntity="pm63_mag"
